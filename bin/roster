#!/usr/bin/env bash
# roster — launch a khimaira multi-agent roster as splits in the current kitty tab
#
# Layouts:
#   splits (default) — 3 columns:
#     Col A (left):   intake / master
#     Col B (middle): architect / analyst / verifier / critic  (4 stacked)
#     Col C (right):  observer / agent-1 / agent-2 / agent-3  (4 stacked)
#
#   hub — solar system: master full-height in center, others orbit:
#     Col A (left):   intake / analyst / architect / verifier / critic
#     Col B (center): MASTER (top, large) / tracker (bottom, small)
#     Col C (right):  observer / agent-1 / agent-2 / agent-3
#
#   grid | tall | fat | horizontal | vertical — kitty native layouts (sequential order)
#
# Usage:
#   roster jp resume
#   roster jp resume --layout hub                  # solar-system layout
#   roster jp resume --layout grid                 # equal kitty grid
#   roster jp resume --analyst --verifier          # force-add if not found
#   roster jp resume --order "intake,master,..."   # manual sequential order
#
# Flags:
#   --prefix <p>        session name prefix
#   --master <name>     master session name
#   --intake <name>     intake session name
#   --agents <n>        number of agents (default: 3)
#   --analyst           include analyst (start fresh in resume if needed)
#   --no-analyst        exclude analyst
#   --verifier          include verifier (start fresh in resume if needed)
#   --no-verifier       exclude verifier
#   --no-observer       exclude observer
#   --no-architect      exclude architect
#   --no-critic         exclude critic
#   --backend-lead      include backend-lead (start fresh in resume if needed)
#   --data-lead         include data-lead (start fresh in resume if needed)
#   --frontend-lead     include frontend-lead (start fresh in resume if needed)
#   --no-backend-lead / --no-data-lead / --no-frontend-lead   exclude the respective lead
#   --layout <name>     grid (default) | splits | hub | tall | fat | horizontal | vertical
#   --order <list>      manual comma-separated order (uses sequential/kitty-native layout)
#   --cwd <path>        working directory

set -euo pipefail

# --- role lookups ---
role_model()  { case "$1" in master|architect|intake) echo claude-opus-4-8 ;; observer|tracker) echo haiku ;; *) echo sonnet ;; esac; }
role_effort() { case "$1" in architect) echo max ;; master) echo high ;; observer) echo low ;; *) echo medium ;; esac; }
role_tier()   { case "$1" in master) echo 1 ;; architect|analyst|verifier) echo 2 ;; intake) echo 3 ;; backend-lead|data-lead|frontend-lead) echo 3 ;; agent) echo 4 ;; critic) echo 5 ;; observer) echo 6 ;; tracker) echo 7 ;; *) echo 4 ;; esac; }
# Column assignment:
#   Col 1 (left, tall): master, intake, architect, analyst, verifier — primary/thinkers
#   Col 2 (right, stacked): agents / leads                           — executors + domain leads
#   Passive (observer, critic) go at bottom of col 1
role_col() {
    case "$1" in
        agent|backend-lead|data-lead|frontend-lead) echo 2 ;;
        *)        echo 1 ;;  # everyone else in col 1; passive roles sort to bottom via tier
    esac
}

infer_role() {
    local name="$1" prefix="$2"
    local stripped="${name#"$prefix"}"
    echo "${stripped%-*}"
}

# --- parse args ---
PROJECT="khimaira"; MODE="start"
OPT_PREFIX=""; OPT_MASTER=""; OPT_INTAKE=""
OPT_AGENTS=3
OPT_ANALYST=true; OPT_VERIFIER=true; OPT_TRACKER=true
OPT_OBSERVER=true; OPT_ARCHITECT=true; OPT_CRITIC=true
OPT_BACKEND_LEAD=false; OPT_DATA_LEAD=false; OPT_FRONTEND_LEAD=false
OPT_LAYOUT="grid"; OPT_ORDER=""; OPT_CWD=""
OPT_NO_PROXY=false
declare -A FORCE_INCLUDE

POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --prefix)       OPT_PREFIX="$2";   shift 2 ;;
        --master)       OPT_MASTER="$2";   shift 2 ;;
        --intake)       OPT_INTAKE="$2";   shift 2 ;;
        --agents)       OPT_AGENTS="$2";   shift 2 ;;
        --analyst)      OPT_ANALYST=true;  FORCE_INCLUDE[analyst]=1;   shift ;;
        --no-analyst)   OPT_ANALYST=false; unset "FORCE_INCLUDE[analyst]"; shift ;;
        --verifier)     OPT_VERIFIER=true; FORCE_INCLUDE[verifier]=1;  shift ;;
        --no-verifier)  OPT_VERIFIER=false; unset "FORCE_INCLUDE[verifier]"; shift ;;
        --tracker)      OPT_TRACKER=true;  FORCE_INCLUDE[tracker]=1;   shift ;;
        --no-tracker)   OPT_TRACKER=false; unset "FORCE_INCLUDE[tracker]"; shift ;;
        --observer)     OPT_OBSERVER=true; FORCE_INCLUDE[observer]=1;  shift ;;
        --no-observer)  OPT_OBSERVER=false; unset "FORCE_INCLUDE[observer]"; shift ;;
        --architect)    OPT_ARCHITECT=true; FORCE_INCLUDE[architect]=1; shift ;;
        --no-architect) OPT_ARCHITECT=false; unset "FORCE_INCLUDE[architect]"; shift ;;
        --critic)           OPT_CRITIC=true;        FORCE_INCLUDE[critic]=1;        shift ;;
        --no-critic)        OPT_CRITIC=false;       unset "FORCE_INCLUDE[critic]";  shift ;;
        --backend-lead)     OPT_BACKEND_LEAD=true;  FORCE_INCLUDE[backend-lead]=1;  shift ;;
        --no-backend-lead)  OPT_BACKEND_LEAD=false; unset "FORCE_INCLUDE[backend-lead]"; shift ;;
        --data-lead)        OPT_DATA_LEAD=true;     FORCE_INCLUDE[data-lead]=1;     shift ;;
        --no-data-lead)     OPT_DATA_LEAD=false;    unset "FORCE_INCLUDE[data-lead]"; shift ;;
        --frontend-lead)    OPT_FRONTEND_LEAD=true;  FORCE_INCLUDE[frontend-lead]=1;  shift ;;
        --no-frontend-lead) OPT_FRONTEND_LEAD=false; unset "FORCE_INCLUDE[frontend-lead]"; shift ;;
        --layout)       OPT_LAYOUT="$2";   shift 2 ;;
        --order)        OPT_ORDER="$2";    shift 2 ;;
        --cwd)          OPT_CWD="$2";      shift 2 ;;
        --no-proxy)     OPT_NO_PROXY=true; shift ;;
        --*)            echo "Unknown flag: $1" >&2; exit 1 ;;
        *)              POSITIONAL+=("$1"); shift ;;
    esac
done

# Positional form is `roster <project> <mode>`, but `roster resume` (mode-only,
# project defaults to khimaira) is the common case. Detect that by checking if
# the first positional is a known mode keyword.
if [[ ${#POSITIONAL[@]} -eq 1 && ( "${POSITIONAL[0]}" == "start" || "${POSITIONAL[0]}" == "resume" ) ]]; then
    MODE="${POSITIONAL[0]}"
else
    [[ ${#POSITIONAL[@]} -gt 0 ]] && PROJECT="${POSITIONAL[0]}"
    [[ ${#POSITIONAL[@]} -gt 1 ]] && MODE="${POSITIONAL[1]}"
fi

# --- project defaults ---
if [[ "$PROJECT" == "khimaira" ]]; then
    PREFIX="${OPT_PREFIX:-}"; MASTER="${OPT_MASTER:-khimaira-0}"; CWD="${OPT_CWD:-/home/_3ntropy/dev/khimaira}"
elif [[ "$PROJECT" == "jp" ]]; then
    PREFIX="${OPT_PREFIX:-jp-}"; MASTER="${OPT_MASTER:-janice-0}"; CWD="${OPT_CWD:-/home/_3ntropy/work/jeevy_portal}"
else
    PREFIX="${OPT_PREFIX:-${PROJECT}-}"; MASTER="${OPT_MASTER:-${PROJECT}-0}"; CWD="${OPT_CWD:-${HOME}/work/${PROJECT}}"
fi

INTAKE="${OPT_INTAKE:-${PREFIX}intake-1}"
# `echo "-n"` produces empty output — bash treats -n as the no-newline flag.
# Use printf so the literal `-n` is preserved. Same for any other `echo "-X"`.
FLAG=$([[ "$MODE" == "resume" ]] && printf -- '-r' || printf -- '-n')

# --- session pool ---
declare -A SESSION_BUDGET SESSION_TIER SESSION_ROLE
add_session() {
    local name="$1" role="$2"
    SESSION_BUDGET["$name"]="$(role_model "$role"):$(role_effort "$role")"
    SESSION_TIER["$name"]="$(role_tier "$role")"
    SESSION_ROLE["$name"]="$role"  # store explicitly — name may not encode role (e.g. janice-0)
}

add_session "$MASTER"  master
add_session "$INTAKE"  intake
for i in $(seq 1 "$OPT_AGENTS"); do add_session "${PREFIX}agent-${i}" agent; done
$OPT_OBSERVER  && add_session "${PREFIX}observer-1"  observer
$OPT_ARCHITECT && add_session "${PREFIX}architect-1" architect
$OPT_CRITIC    && add_session "${PREFIX}critic-1"    critic
$OPT_ANALYST   && add_session "${PREFIX}analyst-1"   analyst
$OPT_VERIFIER  && add_session "${PREFIX}verifier-1"  verifier
$OPT_TRACKER       && add_session "${PREFIX}tracker-1"       tracker
$OPT_BACKEND_LEAD  && add_session "${PREFIX}backend-lead-1"  backend-lead
$OPT_DATA_LEAD     && add_session "${PREFIX}data-lead-1"     data-lead
$OPT_FRONTEND_LEAD && add_session "${PREFIX}frontend-lead-1" frontend-lead

# --- resolve which sessions to launch (resume skip logic) ---
declare -A KNOWN_SESSIONS
if [[ "$MODE" == "resume" ]]; then
    known_json=$(curl -sf 'http://127.0.0.1:8740/api/sessions' 2>/dev/null || echo '{"sessions":[]}')
    while IFS= read -r sname; do
        [[ -n "$sname" ]] && KNOWN_SESSIONS["$sname"]=1
    done < <(echo "$known_json" | python3 -c "
import sys,json; data=json.load(sys.stdin)
for s in (data.get('sessions', data) if isinstance(data,dict) else data):
    n=s.get('name','')
    if n: print(n)
" 2>/dev/null || true)
fi

# Resume mode: auto-add any running *-lead session to the pool even without an
# explicit flag. Matches "resume = restore the live roster" semantics.
# Role-keyed via *-lead glob — future leads (devops-lead, etc.) inherit.
# Start mode is unchanged: leads remain opt-in via --backend-lead/--data-lead.
if [[ "$MODE" == "resume" ]]; then
    for sname in "${!KNOWN_SESSIONS[@]}"; do
        [[ -n "$PREFIX" && "$sname" != "$PREFIX"* ]] && continue
        _resume_role=$(infer_role "$sname" "$PREFIX")
        [[ "$_resume_role" != *-lead ]] && continue
        # When PREFIX is empty (khimaira default), infer_role strips nothing,
        # so a project-prefixed name like "jp-frontend-lead-1" yields
        # "jp-frontend-lead" — still matches *-lead and would scoop the
        # jp-* leads into khimaira's roster. Require canonical bare-lead
        # shape (<role>-lead) to keep cross-project leads out.
        [[ -z "$PREFIX" && ! "$_resume_role" =~ ^[a-z]+-lead$ ]] && continue
        [[ -n "${SESSION_ROLE[$sname]:-}" ]] && continue
        add_session "$sname" "$_resume_role"
        echo "  + resume auto-detected lead: $sname ($_resume_role)"
    done
fi

# Determine effective flag (resume vs fresh) for each session
session_flag() {
    local name="$1" role="$2"
    # Explicit --<role> flag: always start fresh with -n.
    # KNOWN_SESSIONS comes from khimaira's API which records every name ever
    # seen — including from previous failed attempts where Claude Code never
    # persisted a session file. Trying to -r a name khimaira knows but Claude
    # Code can't resume drops you on the "No sessions match" picker.
    # The --<role> flag is the user's explicit "I want this role fresh" signal.
    if [[ -n "${FORCE_INCLUDE[$role]:-}" ]]; then
        # `echo "-n"` is empty (bash builtin interprets -n as the no-newline flag).
        # Use printf so the literal `-n` survives to claude.
        printf -- '-n\n'
        return
    fi
    if [[ "$MODE" == "resume" && -z "${KNOWN_SESSIONS[$name]:-}" ]]; then
        echo "skip"
    else
        # printf, not echo: `echo "$FLAG"` produces empty when FLAG="-n"
        # (bash echo treats -n as the no-newline flag).
        printf -- '%s\n' "$FLAG"
    fi
}

# --- pre-flight (START only): REAP a replaced roster's dead records ---
# Each start, before launching, delete the session records THIS roster owns (master +
# prefix*) whose kitty window is CLOSED — i.e. dead leftovers from a prior launch. Without
# this they accumulate into the session-list buildup + name-entanglement (multiple
# muther-agent-1, scrambled name↔id) that previously required manual cleanup. Safe: we
# reap ONLY names with NO open window (a still-running roster is left untouched), and
# reap=true lets the daemon delete them despite the alive-guard (it can't tell a just-
# closed session from a live one by mtime). Resume mode intentionally keeps everything.
if [[ "$MODE" == "start" ]]; then
    _open_titles=$(kitty @ "${KITTY_TO[@]}" ls 2>/dev/null | python3 -c "
import sys, json
try: d = json.load(sys.stdin)
except Exception: sys.exit()
for o in d:
    for t in o.get('tabs', []):
        for w in t.get('windows', []):
            tt = (w.get('title') or '').strip()
            if tt: print(tt)
" 2>/dev/null)
    _reap_ids=$(curl -sf 'http://127.0.0.1:8740/api/sessions' 2>/dev/null | \
        MASTER="$MASTER" PREFIX="$PREFIX" OPEN_TITLES="$_open_titles" python3 -c "
import sys, json, os
master = os.environ.get('MASTER', ''); prefix = os.environ.get('PREFIX', '')
open_titles = set(x for x in os.environ.get('OPEN_TITLES', '').splitlines() if x)
try: data = json.load(sys.stdin)
except Exception: sys.exit()
for s in (data.get('sessions') or []):
    n = s.get('name') or ''; sid = s.get('session_id') or ''
    if sid.count('-') != 4: continue                       # real UUID only
    if not ((n == master) or (prefix and n.startswith(prefix))): continue  # this roster's
    if n in open_titles: continue                          # has a LIVE window — protect it
    print(sid)
" 2>/dev/null)
    if [[ -n "$_reap_ids" ]]; then
        _rc=$(echo "$_reap_ids" | grep -c .)
        echo "  pre-flight: reaping $_rc dead '${PREFIX:-$MASTER}*' record(s) from a prior launch (frees names, prevents buildup)..."
        while IFS= read -r _sid; do
            [[ -n "$_sid" ]] && curl -sf -X DELETE "http://127.0.0.1:8740/api/sessions/$_sid?force=true&reap=true" >/dev/null 2>&1 || true
        done <<< "$_reap_ids"
        echo "  pre-flight: done."
    fi
    # Clear stale TRAP-2 token files (window-id → slot) for CLOSED windows. The daemon
    # TRUSTS the token over the session's asserted slot, so a reused kitty window-id that
    # still has an OLD token binds the new session to the WRONG slot (the master-on-
    # verifier-slot scramble we hit). Removing closed-window tokens kills that source.
    # (Literal path — matches _ROSTER_TOKEN_DIR, which is set below, after this preflight.)
    _toks="$HOME/.local/state/khimaira/roster-tokens"
    if [[ -d "$_toks" ]]; then
        _open_wids=$(kitty @ "${KITTY_TO[@]}" ls 2>/dev/null | python3 -c "
import sys, json
try: d = json.load(sys.stdin)
except Exception: sys.exit()
for o in d:
    for t in o.get('tabs', []):
        for w in t.get('windows', []): print(w.get('id'))
" 2>/dev/null)
        _tc=0
        for _tf in "$_toks"/*; do
            [[ -f "$_tf" ]] || continue
            _twid=$(basename "$_tf")
            [[ "$_twid" =~ ^[0-9]+$ ]] || continue
            grep -qx "$_twid" <<< "$_open_wids" || { rm -f "$_tf"; _tc=$((_tc+1)); }
        done
        [[ "$_tc" -gt 0 ]] && echo "  pre-flight: cleared $_tc stale window-token(s) (prevents slot-scramble)."
    fi
fi

# --- kitty remote control setup ---
[[ -z "${KITTY_WINDOW_ID:-}" ]] && { echo "ERROR: not running inside kitty." >&2; exit 1; }
KITTY_TO=(); [[ -n "${KITTY_LISTEN_ON:-}" ]] && KITTY_TO=(--to "$KITTY_LISTEN_ON")

# Test remote control using a known-valid layout (hub/splits are custom names, not kitty-native)
if ! kitty @ "${KITTY_TO[@]}" goto-layout splits 2>/dev/null; then
    echo "ERROR: kitty remote control not available." >&2
    echo "Add 'allow_remote_control yes' to ~/.config/kitty/kitty.conf and restart kitty." >&2
    exit 1
fi

# Set the actual kitty layout — hub and splits both use kitty's splits engine
case "$OPT_LAYOUT" in
    hub|splits) ;; # already set to splits above
    *)          kitty @ "${KITTY_TO[@]}" goto-layout "$OPT_LAYOUT" 2>/dev/null || true ;;
esac

# Roster instance ID: unique per `roster` invocation (uuidgen-per-launch).
# Stamped into every window's KHIMAIRA_ROSTER_SLOT env as '<INSTANCE_ID>:<name>'
# so the daemon can resolve same-named sessions from different roster launches.
# TRAP-2: a per-window token file (0600) is also written for daemon-verifiable
# binding — the session asserts its slot via env, the daemon verifies against
# the token file written HERE (by the roster script, not by the session itself).
# Auto-route this roster's sessions through the khimaira concurrency-proxy when it's
# alive (port 8741), so `roster jp resume` just works with no env prefix. Opt out with
# --no-proxy; an explicit KHIMAIRA_PROXY_URL always wins. Routes ONLY when the proxy
# answers /health — never-dark discipline: if the proxy is down, go direct rather than
# point sessions at a dead ANTHROPIC_BASE_URL (which would hard-fail every API call).
_PROXY_DEFAULT_URL="http://127.0.0.1:8741"
if [[ "$OPT_NO_PROXY" != "true" && -z "${KHIMAIRA_PROXY_URL:-}" ]]; then
    if curl -sf --max-time 2 "$_PROXY_DEFAULT_URL/health" >/dev/null 2>&1; then
        export KHIMAIRA_PROXY_URL="$_PROXY_DEFAULT_URL"
        echo "  → khimaira-proxy alive — routing sessions through $_PROXY_DEFAULT_URL (--no-proxy to disable)"
    fi
fi

# Roster instance ID — STABLE across resumes of the same roster.
# The slot key is "<INSTANCE_ID>:<name>" and the daemon's identity-heal (slot-registry
# slot_resolve: old-sid → current-sid) is keyed on it. A fresh uuid every launch made
# `roster <p> resume` create a NEW slot namespace → the heal couldn't bridge identity
# across the resume → roster disorder + session-id proliferation + roles re-claiming
# master. So: persist the instance-id per project; RESUME reuses the saved one (same
# slots → heal bridges old→new sid); START generates a fresh one (a genuinely new roster).
_ROSTER_INSTANCE_DIR="$HOME/.local/state/khimaira/roster-instance"
mkdir -p "$_ROSTER_INSTANCE_DIR"
_ROSTER_INSTANCE_FILE="$_ROSTER_INSTANCE_DIR/$PROJECT"
if [[ "$MODE" == "resume" && -s "$_ROSTER_INSTANCE_FILE" ]]; then
    ROSTER_INSTANCE_ID=$(<"$_ROSTER_INSTANCE_FILE")
    echo "  → resume: reusing roster-instance $ROSTER_INSTANCE_ID (stable slot identity across restart)"
else
    ROSTER_INSTANCE_ID=$(uuidgen)
    printf '%s' "$ROSTER_INSTANCE_ID" > "$_ROSTER_INSTANCE_FILE"
    [[ "$MODE" == "resume" ]] && echo "  → resume: no saved instance for '$PROJECT' — generating $ROSTER_INSTANCE_ID (one-time; subsequent resumes are stable)"
fi
_ROSTER_TOKEN_DIR="$HOME/.local/state/khimaira/roster-tokens"
mkdir -p "$_ROSTER_TOKEN_DIR"

# --- initial-turn prompt (ROOT fix for "idle sessions never register") ---
# The daemon discovers a session ONLY when its transcript file appears, and Claude Code
# doesn't write a transcript until the session takes its FIRST TURN. An idle roster window
# (sitting at the prompt) therefore never registers — invisible to session_list, bootstrap,
# and dispatch. Passing a tiny initial prompt makes each session take one turn on boot, so
# it writes a transcript and registers immediately — no nudge, no manual relaunch.
# (Verified: an idle session launched WITH this prompt registers; without it, it does not.)
_INIT_PROMPT="You are online in the roster. Register now: call mcp__khimaira-chat__chat_my_chats with session_id set to your own id (shown in the session_id block at the top of your context). Then reply: standing by. Do not begin any work until master sends your role brief."
# The MASTER orchestrates — it must NOT "stand by for a role brief" (it GIVES the briefs).
_MASTER_INIT_PROMPT="You are the MASTER (orchestrator) of this roster. Register: call mcp__khimaira-chat__chat_my_chats with your session_id from the session_id block at the top of your context. Then read your handoff (it surfaces on boot) and BEGIN ORCHESTRATING — your workers are coming online and standing by for your role briefs. You GIVE the briefs; do not wait for one."
# Pick the initial prompt for a session by its role (master → orchestrator prompt; rest → standby).
_init_prompt_for() {
    case "${SESSION_ROLE[$1]:-}" in
        master) printf '%s' "$_MASTER_INIT_PROMPT" ;;
        *)      printf '%s' "$_INIT_PROMPT" ;;
    esac
}

# After a roster window launches: write its TRAP-2 token, auto-confirm the
# --dangerously-load-development-channels prompt (so the operator never has to click "1.
# local development" on 14 windows), and STAGGER the next boot so N sessions don't hammer
# the khimaira-chat MCP server simultaneously (the bulk-start overload). The dev-channels
# prompt's default selection is option 1, so a bare Enter accepts it; auto-confirm runs in
# the background with spaced Enters to cover render-timing variance. Stagger is tunable via
# _ROSTER_STAGGER_S (default 2s).
_post_launch() {
    local wid="$1" slot="${2:-}"
    [[ -z "$wid" ]] && return
    if [[ -n "$slot" ]]; then
        printf '%s' "$slot" > "$_ROSTER_TOKEN_DIR/$wid"
        chmod 0600 "$_ROSTER_TOKEN_DIR/$wid"
    fi
    # Auto-confirm: POLL for the dev-channels confirm prompt and press Enter (default =
    # option 1) only when it's actually on screen. Polling (not blind timed Enters) is
    # robust to slow MCP-connect boots AND avoids a stray Enter landing on an unrelated
    # permission prompt. Up to ~30s, then a second Enter if it's still showing.
    ( for _ in $(seq 1 15); do
        sleep 2
        if kitty @ "${KITTY_TO[@]}" get-text --match "id:$wid" 2>/dev/null \
             | grep -q "I am using this for local development"; then
            kitty @ "${KITTY_TO[@]}" send-key --match "id:$wid" enter 2>/dev/null
            sleep 1
            kitty @ "${KITTY_TO[@]}" get-text --match "id:$wid" 2>/dev/null \
              | grep -q "I am using this for local development" \
              && kitty @ "${KITTY_TO[@]}" send-key --match "id:$wid" enter 2>/dev/null
            break
        fi
      done ) &
    sleep "${_ROSTER_STAGGER_S:-2}"
}

# Launch one window; echoes its kitty window ID (integer).
do_launch() {
    local name="$1" model="$2" effort="$3" flag="$4"
    shift 4
    local slot="$ROSTER_INSTANCE_ID:$name"
    local wid
    # Route this roster's sessions through the khimaira concurrency-proxy when
    # KHIMAIRA_PROXY_URL is set (e.g. KHIMAIRA_PROXY_URL=http://127.0.0.1:8741 roster jp).
    # ENABLE_TOOL_SEARCH=1 is mandatory — ANTHROPIC_BASE_URL disables MCP tool-search
    # otherwise. Scoped to THIS roster launch (per-session --env), not global.
    local proxy_env=()
    if [[ -n "${KHIMAIRA_PROXY_URL:-}" ]]; then
        proxy_env=(--env "ANTHROPIC_BASE_URL=$KHIMAIRA_PROXY_URL" --env "ENABLE_TOOL_SEARCH=1")
    fi
    wid=$(kitty @ "${KITTY_TO[@]}" launch \
        --type=window \
        --title="$name" \
        --cwd="$CWD" \
        --env "KHIMAIRA_ROSTER_SLOT=$slot" \
        ${proxy_env[@]+"${proxy_env[@]}"} \
        "$@" \
        -- bash -ic "cd '$CWD' && claude-chat $flag $name --model $model --effort $effort \"$(_init_prompt_for "$name")\"; exec bash")
    # TRAP-2 token (window-id → slot, daemon reads it BY PATH) + auto-confirm the
    # dev-channels prompt + stagger the next boot. See _post_launch.
    _post_launch "$wid" "$slot"
    echo "$wid"
}


# Focus by kitty window ID (unique, no race on title); sleep lets kitty settle
focus() {
    local _fid="$1" _attempt
    for _attempt in 1 2 3; do
        kitty @ "${KITTY_TO[@]}" focus-window --match "id:$_fid" 2>/dev/null && break
        sleep 0.15
    done
    sleep 0.2  # settle after successful focus
}

# --- 3-column splits layout ---
# Col A (left):   intake (top) / master (bottom)
# Col B (middle): architect / analyst / verifier / critic  — 4 equal, stacked
# Col C (right):  observer / agent-1 / agent-2 / agent-3  — 4 equal, stacked
do_3col_layout() {
    # Collect sessions by role, respecting resume skip logic
    get_entry() {
        local role="$1"
        for name in "${!SESSION_ROLE[@]}"; do
            [[ "${SESSION_ROLE[$name]}" != "$role" ]] && continue
            local sflag; sflag=$(session_flag "$name" "$role")
            [[ "$sflag" == "skip" ]] && { printf "  %-22s skipped (pass --%s to force)\n" "$name" "$role"; echo ""; return; }
            IFS=: read -r model effort <<< "${SESSION_BUDGET[$name]}"
            echo "$name:$model:$effort:$sflag"
            return
        done
        echo ""
    }

    get_agents() {
        local agents=()
        for name in "${!SESSION_ROLE[@]}"; do
            local r="${SESSION_ROLE[$name]}"
            [[ "$r" != "agent" && "$r" != "backend-lead" && "$r" != "data-lead" && "$r" != "frontend-lead" ]] && continue
            local sflag; sflag=$(session_flag "$name" "$r")
            [[ "$sflag" == "skip" ]] && { printf "  %-22s skipped\n" "$name"; continue; }
            IFS=: read -r model effort <<< "${SESSION_BUDGET[$name]}"
            agents+=("$name:$model:$effort:$sflag")
        done
        printf '%s\n' "${agents[@]}" | sort
    }

    local e_intake e_master e_arch e_anal e_verif e_crit e_obs
    e_intake=$(get_entry intake)
    e_master=$(get_entry master)
    e_arch=$(get_entry architect)
    e_anal=$(get_entry analyst)
    e_verif=$(get_entry verifier)
    e_crit=$(get_entry critic)
    e_obs=$(get_entry observer)

    local agent_entries=()
    while IFS= read -r line; do [[ -n "$line" ]] && agent_entries+=("$line"); done < <(get_agents)

    [[ -z "$e_intake" ]] && { echo "ERROR: intake session required for layout." >&2; exit 1; }

    echo ""
    echo "  Col A (left)  : intake / master"
    echo "  Col B (middle): architect / analyst / verifier / critic"
    echo "  Col C (right) : observer / agents"
    echo ""

    local intake_name arch_name obs_name col_b_prev_name col_c_prev_name

    local id_intake id_arch id_obs id_master id_col_b_anchor

    # 1. Launch intake → fills screen (Col A top)
    IFS=: read -r name model effort sflag <<< "$e_intake"
    printf "  launching %-22s %s/%s\n" "$name" "$model" "$effort"
    id_intake=$(do_launch "$name" "$model" "$effort" "$sflag")

    # 2. vsplit intake → architect starts Col B
    id_arch=""
    if [[ -n "$e_arch" ]]; then
        focus "$id_intake"
        IFS=: read -r name model effort sflag <<< "$e_arch"
        printf "  launching %-22s %s/%s\n" "$name" "$model" "$effort"
        id_arch=$(do_launch "$name" "$model" "$effort" "$sflag" --location=vsplit)
    fi

    # 3. vsplit Col B anchor → observer starts Col C
    id_obs=""
    id_col_b_anchor="${id_arch:-$id_intake}"
    if [[ -n "$e_obs" ]]; then
        focus "$id_col_b_anchor"
        IFS=: read -r name model effort sflag <<< "$e_obs"
        printf "  launching %-22s %s/%s\n" "$name" "$model" "$effort"
        id_obs=$(do_launch "$name" "$model" "$effort" "$sflag" --location=vsplit)
    fi

    # 4. hsplit intake → master below (Col A bottom)
    id_master=""
    if [[ -n "$e_master" ]]; then
        focus "$id_intake"
        IFS=: read -r name model effort sflag <<< "$e_master"
        printf "  launching %-22s %s/%s\n" "$name" "$model" "$effort"
        id_master=$(do_launch "$name" "$model" "$effort" "$sflag" --location=hsplit)
    fi

    # 5. Stack Col B: analyst / verifier / critic below architect
    local id_col_b_prev="$id_arch"
    for e in "$e_anal" "$e_verif" "$e_crit"; do
        [[ -z "$e" || -z "$id_col_b_prev" ]] && continue
        focus "$id_col_b_prev"
        IFS=: read -r name model effort sflag <<< "$e"
        printf "  launching %-22s %s/%s\n" "$name" "$model" "$effort"
        id_col_b_prev=$(do_launch "$name" "$model" "$effort" "$sflag" --location=hsplit)
    done

    # 6. Stack Col C: agents below observer
    local id_col_c_prev="$id_obs"
    for entry in "${agent_entries[@]}"; do
        [[ -z "$id_col_c_prev" ]] && break
        focus "$id_col_c_prev"
        IFS=: read -r name model effort sflag <<< "$entry"
        printf "  launching %-22s %s/%s\n" "$name" "$model" "$effort"
        id_col_c_prev=$(do_launch "$name" "$model" "$effort" "$sflag" --location=hsplit)
    done

    focus "$id_intake"
}

# --- hub layout ---
# Col A (left,  ~25%): analyst / verifier / critic / architect  — equal small
# Col B (center,~50%): intake (top) / MASTER (bottom)           — equal large
# Col C (right, ~25%): observer / agent-1 / agent-2 / agent-3  — equal small
#
# Strategy: build the layout in a NEW kitty tab via --type=tab. The launch
# terminal stays in the original tab and never participates in the splits tree.
# Natural splits give A=50%/B=25%/C=25%, then `resize-window` post-hoc shrinks
# A by 25% (giving the freed space to B) for the final A=25%/B=50%/C=25%.
do_hub_layout() {
    # Hub 4-column width percentages (tunable). Must sum to ~100.
    # A=thinkers · B=coordination · C=leads+observer · D=agents
    local HUB_COL_A_PCT=20  # thinkers (analyst/verifier/critic/architect)
    local HUB_COL_B_PCT=33  # coordination (intake/master/tracker — widest)
    local HUB_COL_C_PCT=27  # leads + observer (wider than agents)
    local HUB_COL_D_PCT=20  # agents (narrowest)
    local _name _model _effort _sflag

    get_entry() {
        local role="$1"
        for _name in "${!SESSION_ROLE[@]}"; do
            [[ "${SESSION_ROLE[$_name]}" != "$role" ]] && continue
            _sflag=$(session_flag "$_name" "$role")
            [[ "$_sflag" == "skip" ]] && { printf "  %-22s skipped (pass --%s to force)\n" "$_name" "$role"; echo ""; return; }
            IFS=: read -r _model _effort <<< "${SESSION_BUDGET[$_name]}"
            echo "$_name:$_model:$_effort:$_sflag"
            return
        done
        echo ""
    }

    local e_intake e_master e_arch e_anal e_verif e_crit e_obs e_tracker
    e_intake=$(get_entry intake)
    e_master=$(get_entry master)
    e_arch=$(get_entry architect)
    e_anal=$(get_entry analyst)
    e_verif=$(get_entry verifier)
    e_crit=$(get_entry critic)
    e_obs=$(get_entry observer)
    e_tracker=$(get_entry tracker)

    # Col A: thinkers
    local left_sessions=()
    for e in "$e_anal" "$e_verif" "$e_crit" "$e_arch"; do
        [[ -n "$e" ]] && left_sessions+=("$e")
    done

    # Col C: leads (role *-lead, role-keyed — future leads inherit) + observer
    local col_c_sessions=()
    for _name in "${!SESSION_ROLE[@]}"; do
        local _r="${SESSION_ROLE[$_name]}"
        [[ "$_r" != *-lead ]] && continue
        _sflag=$(session_flag "$_name" "$_r")
        [[ "$_sflag" == "skip" ]] && continue
        IFS=: read -r _model _effort <<< "${SESSION_BUDGET[$_name]}"
        col_c_sessions+=("$_name:$_model:$_effort:$_sflag")
    done
    col_c_sessions=($(printf '%s\n' "${col_c_sessions[@]}" | sort))
    [[ -n "$e_obs" ]] && col_c_sessions+=("$e_obs")  # observer goes in Col C with leads

    # Col D: agents
    local col_d_sessions=()
    for _name in "${!SESSION_ROLE[@]}"; do
        [[ "${SESSION_ROLE[$_name]}" != "agent" ]] && continue
        _sflag=$(session_flag "$_name" "agent")
        [[ "$_sflag" == "skip" ]] && continue
        IFS=: read -r _model _effort <<< "${SESSION_BUDGET[$_name]}"
        col_d_sessions+=("$_name:$_model:$_effort:$_sflag")
    done
    col_d_sessions=($(printf '%s\n' "${col_d_sessions[@]}" | sort))

    [[ -z "$e_intake" ]] && { echo "ERROR: hub layout requires intake session." >&2; exit 1; }

    echo ""
    echo "  Hub layout 4-col (A=$HUB_COL_A_PCT% · B=$HUB_COL_B_PCT% · C=$HUB_COL_C_PCT% · D=$HUB_COL_D_PCT%) — opens in a NEW kitty tab"
    echo "  Col A : ${#left_sessions[@]} session(s) — analyst/verifier/critic/architect"
    echo "  Col B : intake + master + tracker"
    echo "  Col C : ${#col_c_sessions[@]} session(s) — leads + observer"
    echo "  Col D : ${#col_d_sessions[@]} session(s) — agents"
    echo ""

    local id_la="" id_in="" id_cc="" id_cd=""

    # 1. Col A anchor (or intake if no thinkers): open in a NEW tab.
    #    --type=tab gives us a clean splits tree with no launch terminal in it.
    local anchor_entry
    if [[ ${#left_sessions[@]} -gt 0 ]]; then
        anchor_entry="${left_sessions[0]}"
    else
        anchor_entry="$e_intake"
    fi
    IFS=: read -r _name _model _effort _sflag <<< "$anchor_entry"
    printf "  launching %-22s %s/%s (new tab)\n" "$_name" "$_model" "$_effort"
    # Same proxy routing as do_launch (the anchor bypasses do_launch).
    local _anchor_proxy_env=()
    if [[ -n "${KHIMAIRA_PROXY_URL:-}" ]]; then
        _anchor_proxy_env=(--env "ANTHROPIC_BASE_URL=$KHIMAIRA_PROXY_URL" --env "ENABLE_TOOL_SEARCH=1")
    fi
    local _anchor_slot="$ROSTER_INSTANCE_ID:$_name"
    id_la=$(kitty @ "${KITTY_TO[@]}" launch \
        --type=tab \
        --tab-title="${PROJECT}-roster" \
        --title="$_name" \
        --cwd="$CWD" \
        --env "KHIMAIRA_ROSTER_SLOT=$_anchor_slot" \
        ${_anchor_proxy_env[@]+"${_anchor_proxy_env[@]}"} \
        -- bash -ic "cd '$CWD' && claude-chat $_sflag $_name --model $_model --effort $_effort \"$(_init_prompt_for "$_name")\"; exec bash")
    # TRAP-2 token + auto-confirm dev-channels prompt + stagger (anchor bypasses do_launch).
    _post_launch "$id_la" "$_anchor_slot"

    # If the anchor IS intake (no thinkers), wire id_in and leave id_la empty.
    if [[ ${#left_sessions[@]} -eq 0 ]]; then
        id_in="$id_la"
        id_la=""
    fi

    sleep 0.3
    # Force the new tab into splits layout before any vsplits.
    local target_id="${id_la:-$id_in}"
    kitty @ "${KITTY_TO[@]}" action --match "id:$target_id" goto_layout splits 2>/dev/null || true
    sleep 0.2

    # 2. vsplit Col A anchor → intake (Col B anchor). Natural 50/50.
    # We use natural splits + post-hoc resize-window (chained --bias is unreliable).
    if [[ -n "$id_la" ]]; then
        IFS=: read -r _name _model _effort _sflag <<< "$e_intake"
        focus "$id_la"
        printf "  launching %-22s %s/%s\n" "$_name" "$_model" "$_effort"
        id_in=$(do_launch "$_name" "$_model" "$_effort" "$_sflag" --location=vsplit)
    fi

    # 3. vsplit intake → Col C anchor (first lead, or observer if no leads).
    # Natural: A=50%, B=25%, C=25%.
    local col_c_anchor="" col_c_fill=()
    if [[ ${#col_c_sessions[@]} -gt 0 ]]; then
        col_c_anchor="${col_c_sessions[0]}"
        col_c_fill=("${col_c_sessions[@]:1}")
    fi
    if [[ -n "$col_c_anchor" ]]; then
        IFS=: read -r _name _model _effort _sflag <<< "$col_c_anchor"
        focus "$id_in"
        printf "  launching %-22s %s/%s\n" "$_name" "$_model" "$_effort"
        id_cc=$(do_launch "$_name" "$_model" "$_effort" "$_sflag" --location=vsplit)
    fi

    # 4. vsplit Col C anchor → Col D anchor (first agent).
    # Natural: A=50%, B=25%, C=12.5%, D=12.5%.
    local col_d_anchor="" col_d_fill=()
    if [[ ${#col_d_sessions[@]} -gt 0 ]]; then
        col_d_anchor="${col_d_sessions[0]}"
        col_d_fill=("${col_d_sessions[@]:1}")
    fi
    if [[ -n "$col_d_anchor" ]]; then
        local _col_d_vsplit_anchor="${id_cc:-$id_in}"
        IFS=: read -r _name _model _effort _sflag <<< "$col_d_anchor"
        focus "$_col_d_vsplit_anchor"
        printf "  launching %-22s %s/%s\n" "$_name" "$_model" "$_effort"
        id_cd=$(do_launch "$_name" "$_model" "$_effort" "$_sflag" --location=vsplit)
    fi

    # 5. Col B: master below intake, tracker below master.
    local id_master=""
    if [[ -n "$e_master" ]]; then
        IFS=: read -r _name _model _effort _sflag <<< "$e_master"
        focus "$id_in"
        printf "  launching %-22s %s/%s\n" "$_name" "$_model" "$_effort"
        id_master=$(do_launch "$_name" "$_model" "$_effort" "$_sflag" --location=hsplit)
    fi
    if [[ -n "$e_tracker" && -n "$id_master" ]]; then
        IFS=: read -r _name _model _effort _sflag <<< "$e_tracker"
        focus "$id_master"
        printf "  launching %-22s %s/%s\n" "$_name" "$_model" "$_effort"
        do_launch "$_name" "$_model" "$_effort" "$_sflag" --location=hsplit > /dev/null
    fi

    # 5.5. Equalize Col B vertical heights to equal thirds (33%/33%/33%).
    # After natural hsplits: intake=50%, master=25%, tracker=25%.
    # Two passes:
    #   1. Shrink intake by H/6  → intake=33%, master grows to ~42%
    #   2. Shrink master by H/12 → master=33%, freed space flows to tracker → tracker=33%
    if [[ -n "$e_tracker" && -n "$id_in" && -n "$id_master" ]]; then
        sleep 0.2
        local total_rows
        total_rows=$(kitty @ "${KITTY_TO[@]}" ls 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    for os_win in data:
        for tab in os_win.get('tabs', []):
            if any(w.get('id') == int('$id_in') for w in tab.get('windows', [])):
                print(os_win.get('rows', 60))
                sys.exit()
except Exception:
    pass
print(60)
" 2>/dev/null || echo 60)
        local shrink_intake=$(( total_rows / 6 ))
        local shrink_master=$(( total_rows / 12 ))
        if [[ $shrink_intake -gt 0 ]]; then
            kitty @ "${KITTY_TO[@]}" resize-window \
                --match "id:$id_in" \
                --axis vertical \
                --increment "-$shrink_intake" 2>/dev/null || true
        fi
        if [[ $shrink_master -gt 0 ]]; then
            kitty @ "${KITTY_TO[@]}" resize-window \
                --match "id:$id_master" \
                --axis vertical \
                --increment "-$shrink_master" 2>/dev/null || true
        fi
    fi

    # Balanced recursive hsplit so N panes get equal heights in a column.
    balanced_col() {
        local anchor="$1"; shift
        local entries=("$@")
        local n=${#entries[@]}
        [[ $n -eq 0 ]] && return
        if [[ $n -eq 1 ]]; then
            focus "$anchor"
            IFS=: read -r _name _model _effort _sflag <<< "${entries[0]}"
            printf "  launching %-22s %s/%s\n" "$_name" "$_model" "$_effort"
            do_launch "$_name" "$_model" "$_effort" "$_sflag" --location=hsplit > /dev/null
            return
        fi
        local mid=$(( n / 2 ))
        local bottom_entries=("${entries[@]:$mid}")
        local top_entries=("${entries[@]:0:$mid}")
        focus "$anchor"
        IFS=: read -r _name _model _effort _sflag <<< "${bottom_entries[0]}"
        printf "  launching %-22s %s/%s\n" "$_name" "$_model" "$_effort"
        local bottom_id
        bottom_id=$(do_launch "$_name" "$_model" "$_effort" "$_sflag" --location=hsplit)
        balanced_col "$anchor" "${top_entries[@]}"
        balanced_col "$bottom_id" "${bottom_entries[@]:1}"
    }

    # 6. Fill Col A: remaining thinkers below anchor (balanced equal heights).
    if [[ ${#left_sessions[@]} -gt 1 && -n "$id_la" ]]; then
        balanced_col "$id_la" "${left_sessions[@]:1}"
    fi

    # 7. Fill Col C: remaining leads + observer below anchor (balanced equal heights).
    if [[ ${#col_c_fill[@]} -gt 0 && -n "$id_cc" ]]; then
        balanced_col "$id_cc" "${col_c_fill[@]}"
    fi

    # 8. Fill Col D: remaining agents below anchor (balanced equal heights).
    if [[ ${#col_d_fill[@]} -gt 0 && -n "$id_cd" ]]; then
        balanced_col "$id_cd" "${col_d_fill[@]}"
    fi

    # 9. Equalize column widths to HUB_COL_*_PCT targets.
    # Natural widths after 4 sequential vsplits: A=50%, B=25%, C=12.5%, D=12.5%.
    # Derived increments (exact for the nested-sibling split tree):
    #   Step 1: resize A → HUB_COL_A_PCT
    #     incr_a = total_cols * (HUB_COL_A_PCT - 50) / 100   (negative = shrink)
    #   Step 2: resize B within [B|C|D] group → HUB_COL_B_PCT
    #     After step 1, B = (100-HUB_COL_A_PCT)/2 %. incr_b brings it to target.
    #     incr_b = total_cols * (2*HUB_COL_B_PCT - 100 + HUB_COL_A_PCT) / 200
    #   Step 3: resize C within [C|D] group → HUB_COL_C_PCT
    #     After step 2, C = D = (HUB_COL_C_PCT+HUB_COL_D_PCT)/2 %. incr_c fixes split.
    #     incr_c = total_cols * (HUB_COL_C_PCT - HUB_COL_D_PCT) / 200
    # Verified: A=20,B=33,C=27,D=20 on 200-col terminal → incr_a=-60, incr_b=-14, incr_c=+7.
    # Requires Col A present; if no thinkers (id_la="") all 4 cols stay at natural widths.
    if [[ -n "$id_la" && -n "$id_in" ]]; then
        sleep 0.2
        local total_cols
        total_cols=$(kitty @ "${KITTY_TO[@]}" ls 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    for os_win in data:
        for tab in os_win.get('tabs', []):
            if any(w.get('id') == int('$id_la') for w in tab.get('windows', [])):
                print(os_win.get('columns', 200))
                sys.exit()
except Exception:
    pass
print(200)
" 2>/dev/null || echo 200)
        local incr_a=$(( total_cols * (HUB_COL_A_PCT - 50) / 100 ))
        local incr_b=$(( total_cols * (2 * HUB_COL_B_PCT - 100 + HUB_COL_A_PCT) / 200 ))
        local incr_c=$(( total_cols * (HUB_COL_C_PCT - HUB_COL_D_PCT) / 200 ))
        if [[ $incr_a -ne 0 ]]; then
            kitty @ "${KITTY_TO[@]}" resize-window \
                --match "id:$id_la" --axis horizontal --increment "$incr_a" 2>/dev/null || true
        fi
        if [[ $incr_b -ne 0 ]]; then
            kitty @ "${KITTY_TO[@]}" resize-window \
                --match "id:$id_in" --axis horizontal --increment "$incr_b" 2>/dev/null || true
        fi
        if [[ -n "$id_cc" && $incr_c -ne 0 ]]; then
            kitty @ "${KITTY_TO[@]}" resize-window \
                --match "id:$id_cc" --axis horizontal --increment "$incr_c" 2>/dev/null || true
        fi
    fi

    # Leave focus on intake (col B center).
    [[ -n "$id_in" ]] && focus "$id_in"

}

# --- sequential layout (for --order or non-splits layouts) ---
do_sequential_layout() {
    local sessions=("$@")
    for entry in "${sessions[@]}"; do
        IFS=: read -r name model effort sflag <<< "$entry"
        [[ "$sflag" == "skip" ]] && { printf "  %-22s skipped\n" "$name"; continue; }
        printf "  launching %-22s %s/%s\n" "$name" "$model" "$effort"
        do_launch "$name" "$model" "$effort" "$sflag" > /dev/null
    done
}

# --- main ---
echo "Launching $PROJECT roster ($MODE) — layout: $OPT_LAYOUT"

if [[ "$OPT_LAYOUT" == "hub" && -z "$OPT_ORDER" ]]; then
    do_hub_layout
elif [[ "$OPT_LAYOUT" == "splits" && -z "$OPT_ORDER" ]]; then
    do_3col_layout
else
    # Build ordered list (manual --order or auto-tier-sorted)
    ORDERED=()
    if [[ -n "$OPT_ORDER" ]]; then
        IFS=',' read -ra ORDER_NAMES <<< "$OPT_ORDER"
        for name in "${ORDER_NAMES[@]}"; do
            name="${name// /}"
            role=$(infer_role "$name" "$PREFIX")
            sflag=$(session_flag "$name" "$role")
            if [[ -n "${SESSION_BUDGET[$name]:-}" ]]; then
                IFS=: read -r model effort <<< "${SESSION_BUDGET[$name]}"
            else
                model=$(role_model "$role"); effort=$(role_effort "$role")
                echo "  + auto-adding $name ($role → $model/$effort)"
            fi
            ORDERED+=("$name:$model:$effort:$sflag")
        done
    else
        while IFS= read -r line; do ORDERED+=("$line"); done < <(
            for name in "${!SESSION_TIER[@]}"; do
                role=$(infer_role "$name" "$PREFIX")
                sflag=$(session_flag "$name" "$role")
                IFS=: read -r model effort <<< "${SESSION_BUDGET[$name]}"
                echo "${SESSION_TIER[$name]}:$name:$model:$effort:$sflag"
            done | sort -t: -k1,1n -k2,2 | sed 's/^[0-9]*://'
        )
    fi
    do_sequential_layout "${ORDERED[@]}"
fi

# --- backstop auto-confirm (catches the LAST window) ---
# The per-window auto-confirm polls run in the BACKGROUND as children of this script, and
# this script closes its own launching window at the very end (below) — which kills any
# still-running poll. The LAST-launched window's poll has the least time, so it consistently
# misses. This SYNCHRONOUS final pass confirms any open roster window still showing the
# dev-channels prompt, before the script exits. Only ever acts on that exact prompt, so it
# can never touch a permission/other prompt.
echo "  finalizing: confirming any remaining dev-channels prompts..."
for _pass in $(seq 1 20); do
    _pending=0
    while IFS= read -r _w; do
        [[ -z "$_w" ]] && continue
        if kitty @ "${KITTY_TO[@]}" get-text --match "id:$_w" 2>/dev/null \
             | grep -q "I am using this for local development"; then
            kitty @ "${KITTY_TO[@]}" send-key --match "id:$_w" enter 2>/dev/null
            _pending=1
        fi
    done < <(kitty @ "${KITTY_TO[@]}" ls 2>/dev/null | MASTER="$MASTER" PREFIX="$PREFIX" python3 -c "
import sys, json, os
master = os.environ.get('MASTER', ''); prefix = os.environ.get('PREFIX', '')
try: d = json.load(sys.stdin)
except Exception: sys.exit()
for o in d:
    for t in o.get('tabs', []):
        for w in t.get('windows', []):
            tt = (w.get('title') or '').strip()
            if tt == master or (prefix and tt.startswith(prefix)): print(w.get('id'))
" 2>/dev/null)
    [[ "$_pending" == "0" ]] && break
    sleep 2
done

echo ""
echo "Done. Run /khimaira-bootstrap-roster${PREFIX:+ --prefix ${PREFIX%%-}} inside $MASTER to wire the chat."
sleep 0.5
kitty @ "${KITTY_TO[@]}" close-window --match "id:${KITTY_WINDOW_ID}" 2>/dev/null || true
